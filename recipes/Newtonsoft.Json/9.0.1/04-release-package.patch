+        <file src="Src/Newtonsoft.Json/bin/Release/Net45/Newtonsoft.Json.dll" target="lib/net45" />
+        <file src="Src/Newtonsoft.Json/bin/Release/Net45/Newtonsoft.Json.xml" target="lib/net45" />
+        <file src="Src/Newtonsoft.Json/bin/Release/netstandard1.0/Newtonsoft.Json.dll" target="lib/netstandard1.0" />
+        <file src="Src/Newtonsoft.Json/bin/Release/netstandard1.0/Newtonsoft.Json.xml" target="lib/netstandard1.0" />
